# Example configuration only. Never place real credentials in this file.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
LOG_LEVEL=info
DATABASE_URL=postgres://USER:CHANGE_ME@localhost:5432/ewstrp?sslmode=disable
