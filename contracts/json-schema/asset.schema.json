{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ewstrp/contracts/asset.schema.json",
  "title": "Asset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset_id",
    "tenant_id",
    "name",
    "asset_type",
    "environment",
    "owner_team",
    "criticality",
    "authorization"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "asset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "web_application",
        "api",
        "host",
        "network_device",
        "cloud_resource",
        "other"
      ]
    },
    "environment": {
      "type": "string",
      "enum": [
        "development",
        "test",
        "staging",
        "production",
        "unknown"
      ]
    },
    "owner_team": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "criticality": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      },
      "uniqueItems": true
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "allowed_targets",
        "excluded_targets"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "expired",
            "revoked",
            "not_authorized"
          ]
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "allowed_targets": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "excluded_targets": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "rules_of_engagement_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
