{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ewstrp/contracts/incident.schema.json",
  "title": "Security Incident Creation Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "incident_id",
    "asset_id",
    "timestamp",
    "severity",
    "confidence",
    "title",
    "correlation_id",
    "event_ids",
    "description",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "incident_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "asset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "RFC3339 timestamp in UTC, ending in uppercase Z."
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "event_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "playbook_ref": {
      "type": ["string", "null"],
      "maxLength": 128
    },
    "status": {
      "type": "string",
      "const": "open",
      "description": "New incidents must start with status open."
    }
  }
}