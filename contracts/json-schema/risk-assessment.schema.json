{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ewstrp/contracts/risk-assessment.schema.json",
  "title": "Evidence-Based Risk Assessment",
  "description": "Deterministic risk triage derived from an existing finding. It is not a CVSS calculator or proof that a vulnerability exists.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "assessment_id", "finding_id", "source_status", "assessed_at",
    "source_confidence", "classification", "evidence_quality", "owasp", "severity",
    "priority", "priority_basis", "context", "needs_analyst_review", "review_reasons", "rationale"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "assessment_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "finding_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_status": {
      "type": "string",
      "enum": ["detected", "triaged", "confirmed", "false_positive", "remediating", "fixed_pending_retest", "retest_passed", "accepted_risk", "closed"]
    },
    "assessed_at": {"type": "string", "format": "date-time"},
    "source_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "classification": {
      "type": "string",
      "enum": ["confirmed_vulnerability", "potential_vulnerability", "security_observation", "insufficient_evidence", "false_positive", "accepted_risk"]
    },
    "evidence_quality": {
      "type": "string",
      "enum": ["hash_present_unverified", "referenced_unhashed", "taxonomy_only", "none"]
    },
    "owasp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taxonomy_version", "category_id", "category_name", "mapping_method", "matched_cwe_ids", "unmapped_cwe_ids", "candidate_category_ids"],
      "properties": {
        "taxonomy_version": {"type": "string", "const": "2025"},
        "category_id": {"type": "string", "enum": ["A01:2025", "A02:2025", "A03:2025", "A04:2025", "A05:2025", "A06:2025", "A07:2025", "A08:2025", "A09:2025", "A10:2025", "UNMAPPED"]},
        "category_name": {"type": "string", "minLength": 1, "maxLength": 256},
        "mapping_method": {"type": "string", "enum": ["cwe_rule", "ambiguous_cwe_mapping", "no_supported_cwe_mapping"]},
        "matched_cwe_ids": {"type": "array", "items": {"type": "string", "pattern": "^CWE-[0-9]+$"}, "uniqueItems": true},
        "unmapped_cwe_ids": {"type": "array", "items": {"type": "string", "pattern": "^CWE-[0-9]+$"}, "uniqueItems": true},
        "candidate_category_ids": {"type": "array", "items": {"type": "string", "enum": ["A01:2025", "A02:2025", "A03:2025", "A04:2025", "A05:2025", "A06:2025", "A07:2025", "A08:2025", "A09:2025", "A10:2025"]}, "uniqueItems": true}
      }
    },
    "severity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "basis", "source_reported", "cvss_v4_score", "conflict"],
      "properties": {
        "value": {"type": "string", "enum": ["critical", "high", "medium", "low", "info", "unknown"]},
        "basis": {"type": "string", "enum": ["cvss_v4_0", "source_reported", "unknown"]},
        "source_reported": {"type": "string", "enum": ["critical", "high", "medium", "low", "info", "unknown"]},
        "cvss_v4_score": {"type": ["number", "null"], "minimum": 0, "maximum": 10},
        "conflict": {"type": "boolean"}
      }
    },
    "priority": {"type": "string", "enum": ["P1", "P2", "P3", "P4", "UNASSESSED"]},
    "priority_basis": {"type": "string", "enum": ["known_exploited", "confirmed_critical_internet_exposed", "critical_severity", "high_severity_contextual", "severity_only", "low_severity", "not_applicable", "unknown_severity"]},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["internet_exposed", "known_exploited", "asset_criticality", "sensitive_data"],
      "properties": {
        "internet_exposed": {"type": ["boolean", "null"]},
        "known_exploited": {"type": ["boolean", "null"]},
        "asset_criticality": {"type": "string", "enum": ["critical", "high", "medium", "low", "unknown"]},
        "sensitive_data": {"type": ["boolean", "null"]}
      }
    },
    "needs_analyst_review": {"type": "boolean"},
    "review_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["finding_not_evidence_confirmed", "insufficient_evidence", "observation_only", "disposition_requires_review", "evidence_integrity_not_proven", "evidence_hash_not_verified", "no_cwe_ids_supplied", "no_supported_cwe_mapping", "multiple_owasp_categories", "some_cwe_ids_unmapped", "cvss_severity_mismatch", "severity_unknown", "risk_context_incomplete"]}
    },
    "rationale": {"type": "string", "minLength": 1, "maxLength": 3000}
  }
}