{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ewstrp/contracts/security-event.schema.json",
  "title": "Normalized Security Event Ingestion Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "timestamp",
    "source_product",
    "event_type",
    "asset_id",
    "severity",
    "confidence",
    "correlation_id"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "RFC3339 timestamp in UTC, ending in uppercase Z."
    },
    "source_product": {
      "type": "string",
      "enum": [
        "wazuh",
        "suricata",
        "application_log"
      ]
    },
    "event_type": {
      "type": "string",
      "enum": [
        "alert",
        "flow",
        "http",
        "auth_failure",
        "anomaly"
      ]
    },
    "asset_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 128,
      "description": "Required field; null is allowed when the asset is not identified."
    },
    "severity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "correlation_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 128
    },
    "src_ip": {
      "anyOf": [
        { "type": "string", "format": "ipv4" },
        { "type": "string", "format": "ipv6" },
        { "type": "null" }
      ]
    },
    "dest_ip": {
      "anyOf": [
        { "type": "string", "format": "ipv4" },
        { "type": "string", "format": "ipv6" },
        { "type": "null" }
      ]
    },
    "rule_id": {
      "type": ["string", "null"],
      "maxLength": 256
    },
    "signature": {
      "type": ["string", "null"],
      "maxLength": 512
    },
    "description": {
      "type": ["string", "null"]
    },
    "raw_ref": {
      "type": ["string", "null"],
      "maxLength": 1024,
      "description": "Reference to protected evidence; not a raw event dump."
    }
  }
}